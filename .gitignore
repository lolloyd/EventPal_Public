# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/workers/export-worker/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local storage
/Events/covers/*
!/Events/covers/.gitkeep
/Events/photos/*
!/Events/photos/.gitkeep
/Events/exports/*
!/Events/exports/.gitkeep
/Events/database/*
!/Events/database/.gitkeep

# deployment archives
*.zip
heypal-deploy.zip
heypal-deploy_*.zip


